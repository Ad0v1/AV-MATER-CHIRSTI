// Modulo de autenticacion y auditoria. Dueño: Dev 1.
// Los modelos de otros modulos agregan sus relaciones inversas a User en su propio PR
// (Prisma exige ambos lados de una relacion).

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

// Una identidad por persona (D-012: un solo rol). Dev 2 gestiona altas y edicion (RF-18..23);
// Dev 1 usa este modelo para autenticar y bloquear inactivos (RF-03, RF-08).
model User {
  id                 String     @id @default(uuid(7)) @db.Char(36)
  institutionalEmail String     @unique
  // Codigo de usuario de 10 digitos: es el usuario del login (RF-68, D-060). Nulo solo hasta que el
  // alta de usuarios (fase C) lo genere; despues pasa a ser obligatorio.
  code               String?    @unique @db.Char(10)
  // DNI cifrado (AES-256-GCM) y su hash con clave solo para impedir repetidos (RF-69, D-059).
  dniEncrypted       String?    @db.VarChar(255)
  dniHash            String?    @unique @db.Char(64)
  fullName           String
  role               UserRole
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  localCredential   LocalCredential?
  policyAcceptances PolicyAcceptance[]
  auditLogs         AuditLog[]

  // Relaciones inversas de Dev 2 (academic.prisma)
  taughtCourseSections CourseSection[]   @relation("CourseSectionTeacher")
  enrollments          Enrollment[]      @relation("EnrollmentStudent")
  guardianLinks        GuardianStudent[] @relation("GuardianStudentGuardian")
  wardLinks            GuardianStudent[] @relation("GuardianStudentStudent")

  // Relaciones inversas de Dev 3 (contents.prisma); relación inversa de Dev 3, autorizado por el usuario el 29/10/2026
  uploadedFiles      StoredFile[] @relation("StoredFileUploader")
  createdMaterials   Material[]   @relation("MaterialCreator")
  deletedMaterials   Material[]   @relation("MaterialDeleter")
  createdAssignments Assignment[] @relation("AssignmentCreator")

  @@index([role, status])
}

// Contrasena de cada usuario (D-058). El secreto TOTP, que solo usa el administrador, se guarda
// cifrado; nunca en claro.
model LocalCredential {
  userId              String    @id @db.Char(36)
  passwordHash        String
  totpSecretEncrypted String?
  // Verdadero mientras el usuario no cambie la contrasena inicial o temporal (RF-71, RF-74).
  mustChangePassword  Boolean   @default(false)
  passwordChangedAt   DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Aceptacion de politica y terminos por version (RF-07).
// Se guardan ip y userAgent como evidencia del consentimiento. Restrict: la evidencia
// no se pierde si alguien intenta borrar al usuario (los usuarios se dan de baja con status).
model PolicyAcceptance {
  id            String   @id @default(uuid(7)) @db.Char(36)
  userId        String   @db.Char(36)
  policyVersion String
  acceptedAt    DateTime @default(now())
  ip            String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(255)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, policyVersion])
}

// Bitacora (RNF-14/15). Append-only: la aplicacion solo inserta, nunca actualiza ni borra.
// La base lo refuerza con triggers BEFORE UPDATE/DELETE (migracion auth_ajustes_bitacora).
// Se conserva aunque se purguen los PDF (RF-66, RN-14). Los usuarios se dan de baja con
// status (INACTIVE/WITHDRAWN) y nunca se borran; por eso actor usa Restrict.
// entityType/entityId: entidad sobre la que se actuo (entityId = UUID de la raiz del agregado).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Char(36)
  actorId     String?  @db.Char(36)
  action      String
  module      String
  entityType  String?  @db.VarChar(64)
  entityId    String?  @db.Char(36)
  ip          String?  @db.VarChar(45)
  beforeState Json?
  afterState  Json?
  occurredAt  DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([module, action])
  @@index([entityType, entityId])
  @@index([occurredAt])
}
