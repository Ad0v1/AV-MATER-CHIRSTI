# Copia este archivo a .env y ajusta. NUNCA subas .env a Git.
# Valores de desarrollo local ficticios.

# MySQL
MYSQL_ROOT_PASSWORD=root_dev_change_me
MYSQL_DATABASE=aula_virtual
MYSQL_USER=aula
MYSQL_PASSWORD=aula_dev_change_me
MYSQL_PORT=3306
DATABASE_URL=mysql://aula:aula_dev_change_me@127.0.0.1:3306/aula_virtual

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# MinIO (S3 compatible)
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=aula-privado
S3_REGION=us-east-1
# Archivos de Dev 3 (RNF-03/18), pendiente de revisión por Dev 1. Las credenciales salen de
# S3_ACCESS_KEY_ID y S3_SECRET_ACCESS_KEY (abajo) o, en local, de MINIO_ROOT_USER/PASSWORD.
S3_FORCE_PATH_STYLE=true
# Vigencia de las URL firmadas: 5 min para subir y 60 s para descargar (decisión del 29/10/2026)
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=60

# ClamAV
CLAMAV_PORT=3310
# Antivirus de las subidas (RF-40), Dev 3, pendiente de revisión por Dev 1
CLAMAV_HOST=127.0.0.1
CLAMAV_TIMEOUT_MS=30000

# Mailpit (correo local de prueba)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Worker y trabajos en segundo plano (Dev 5, RNF-19). Colas BullMQ sobre REDIS_URL.
# Correo saliente: en local va a Mailpit (http://localhost:8025). Solo avisos sin datos (U3).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Aula Virtual <no-responder@aula.local>
# Conversion HTML a PDF de los reportes (fase 5f)
GOTENBERG_URL=http://127.0.0.1:3001
# Dias que se conserva una exportacion antes de vencer (U6)
EXPORT_TTL_DAYS=7
# Trabajos en paralelo por cola
WORKER_CONCURRENCY=2

# API
API_PORT=4000
SESSION_TTL_SECONDS=28800
RATE_LIMIT_PER_MINUTE=100
WEB_ORIGIN=http://localhost:3000

# Seguridad de la cuenta local del admin (RF-04)
# Clave AES-256 para cifrar los secretos TOTP. Obligatoria en produccion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER="Aula Virtual"
POLICY_VERSION=2026-1

# Web (Next.js) -> API
API_URL=http://localhost:4000
# La web reenvia /api/v1 a la API, asi que hay un proxy delante
TRUST_PROXY=1

# Respaldos automaticos de la base de datos (ERS RNF-21/22)
# Clave AES-256 de los respaldos. Obligatoria. Guardala FUERA del servidor: sin ella no se restaura.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
# Hora diaria (UTC) del respaldo. 07:00 UTC = 02:00 en Lima
BACKUP_AT_UTC=07:00
S3_BACKUP_BUCKET=aula-backups
S3_ACCESS_KEY_ID=minio_dev
S3_SECRET_ACCESS_KEY=minio_dev_change_me
# Solo desarrollo: ejecuta mysqldump dentro del contenedor de MySQL (no hace falta instalar el cliente)
BACKUP_MYSQL_CONTAINER=av-mater-chirsti-mysql-1
